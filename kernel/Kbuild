trigger6-y := trigger6_drv.o trigger6_connector.o trigger6_codec.o
# HDMI audio needs ALSA PCM; without it the display works as before.
ifneq ($(CONFIG_SND_PCM),)
trigger6-y += trigger6_audio.o
endif
obj-m := trigger6.o

# Detect the API from the target headers, including distro backports.
ifneq ($(shell grep -c '^struct drm_atomic_commit {' $(srctree)/include/drm/drm_atomic.h),0)
ccflags-y += -DT6_HAVE_DRM_ATOMIC_COMMIT
endif
ifneq ($(shell grep -c 'drm_dev_set_dma_dev' $(srctree)/include/drm/drm_device.h),0)
ccflags-y += -DT6_HAVE_DRM_SET_DMA_DEV
endif
ifneq ($(shell grep -c 'void hrtimer_setup.struct hrtimer \*timer' $(srctree)/include/linux/hrtimer.h),0)
ccflags-y += -DT6_HAVE_HRTIMER_SETUP
endif
# The plane's atomic_async_check has a "bool flip" argument since 6.13.
ifeq ($(shell grep -A1 -s 'atomic_async_check..struct drm_plane' $(srctree)/include/drm/drm_modeset_helper_vtables.h | grep -c 'bool flip'),0)
ccflags-y += -DT6_ASYNC_CHECK_NO_FLIP
endif
